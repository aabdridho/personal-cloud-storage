# Salin file ini jadi .env lalu ganti semua nilai "ganti-saya".
# Jangan pernah commit file .env.

# --- Menjalankan API langsung di laptop (tanpa Docker) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=ganti-saya
S3_SECRET_KEY=ganti-saya
S3_BUCKET=cloud-storage
DATABASE_URL=postgresql+psycopg://cloud_app:ganti-saya@127.0.0.1:5432/cloud_storage
JWT_SECRET=ganti-dengan-hasil-python-c-import-secrets-print-secrets.token_urlsafe-48

# Opsional
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# MAX_UPLOAD_MB=1024
# DEFAULT_QUOTA_GB=5

# --- Docker Compose ---
POSTGRES_USER=cloud_app
POSTGRES_PASSWORD=ganti-saya
POSTGRES_DB=cloud_storage
SILO_ROOT_USER=silo-root
SILO_ROOT_PASSWORD=ganti-saya-minimal-8-karakter

# --- Monitoring (Grafana login: admin / nilai ini) ---
GRAFANA_ADMIN_PASSWORD=ganti-saya
